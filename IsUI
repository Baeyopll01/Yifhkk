local library = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService('RunService')
local camera = workspace.CurrentCamera
local Mouse = game.Players.LocalPlayer:GetMouse()

function library:BlurFrame(getFrame)
	local MTREL = "Glass"

	local root = Instance.new('Folder')
	root.Name = 'BlurSnox'
	root.Parent = camera

	local gToken = math.random(1,99999999)

	local DepthOfField = Instance.new('DepthOfFieldEffect')
	DepthOfField.Parent = game:GetService('Lighting')
	DepthOfField.FarIntensity = 0
	DepthOfField.FocusDistance = 51.6
	DepthOfField.InFocusRadius = 50
	DepthOfField.NearIntensity = 1
	DepthOfField.Name = "DPT_"..gToken

	local frame = Instance.new('Frame')
	frame.Parent = getFrame
	frame.Size = UDim2.new(0.95, 0, 0.95, 0)
	frame.Position = UDim2.new(0.5, 0, 0.5, 0)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundTransparency = 1

	local GenUid; do
		local id = 0
		function GenUid()
			id = id + 1
			return 'neon::'..id
		end
	end

	do
		local function IsNotNaN(x)
			return x == x
		end

		repeat
			RunService.RenderStepped:Wait()
		until IsNotNaN(camera:ScreenPointToRay(0,0).Origin.x)
	end

	local DrawQuad; do
		local acos, max, pi, sqrt = math.acos, math.max, math.pi, math.sqrt
		local sz = 0.2

		function DrawTriangle(v1, v2, v3, p0, p1)
			local s1 = (v1 - v2).Magnitude
			local s2 = (v2 - v3).Magnitude
			local s3 = (v3 - v1).Magnitude
			local smax = max(s1, s2, s3)

			local A, B, C
			if s1 == smax then
				A, B, C = v1, v2, v3
			elseif s2 == smax then
				A, B, C = v2, v3, v1
			else
				A, B, C = v3, v1, v2
			end

			local para = ((B-A):Dot(C-A)) / (A-B).Magnitude
			local perp = sqrt((C-A).Magnitude^2 - para*para)
			local dif_para = (A - B).Magnitude - para

			local st = CFrame.new(B, A)
			local za = CFrame.Angles(pi/2,0,0)

			local cf0 = st

			local Top_Look = (cf0 * za).LookVector
			local Mid_Point = A + (CFrame.new(A, B).LookVector * para)
			local Needed_Look = CFrame.new(Mid_Point, C).LookVector

			local dot = Top_Look:Dot(Needed_Look)
			dot = math.clamp(dot, -1, 1) -- 🔥 FIX acos

			local ac = CFrame.Angles(0, 0, acos(dot))
			cf0 = cf0 * ac

			if ((cf0 * za).LookVector - Needed_Look).Magnitude > 0.01 then
				cf0 = cf0 * CFrame.Angles(0, 0, -2*acos(dot))
			end

			cf0 = cf0 * CFrame.new(0, perp/2, -(dif_para + para/2))

			local cf1 = st * ac * CFrame.Angles(0, pi, 0)
			if ((cf1 * za).LookVector - Needed_Look).Magnitude > 0.01 then
				cf1 = cf1 * CFrame.Angles(0, 0, 2*acos(dot))
			end

			cf1 = cf1 * CFrame.new(0, perp/2, dif_para/2)

			if not p0 then
				p0 = Instance.new('Part')
				p0.Anchored = true
				p0.CanCollide = false
				p0.CastShadow = false
				p0.Material = MTREL
				p0.Size = Vector3.new(sz, sz, sz)

				local mesh = Instance.new('SpecialMesh')
				mesh.MeshType = Enum.MeshType.Wedge
				mesh.Name = 'WedgeMesh'
				mesh.Parent = p0
			end

			local mesh0 = p0:FindFirstChild("WedgeMesh")
			if mesh0 then
				mesh0.Scale = Vector3.new(0, perp/sz, para/sz)
			end
			p0.CFrame = cf0

			if not p1 then
				p1 = p0:Clone()
			end

			local mesh1 = p1:FindFirstChild("WedgeMesh")
			if mesh1 then
				mesh1.Scale = Vector3.new(0, perp/sz, dif_para/sz)
			end
			p1.CFrame = cf1

			return p0, p1
		end

		function DrawQuad(v1, v2, v3, v4, parts)
			parts[1], parts[2] = DrawTriangle(v1, v2, v3, parts[1], parts[2])
			parts[3], parts[4] = DrawTriangle(v3, v2, v4, parts[3], parts[4])
		end
	end

	local uid = GenUid()
	local parts = {}

	local f = Instance.new('Folder')
	f.Name = "BlurParts"
	f.Parent = root

	local parents = {}
	do
		local function add(child)
			if child and child:IsA('GuiObject') then
				table.insert(parents, child)
				add(child.Parent)
			end
		end
		add(frame)
	end

	local function UpdateOrientation(first)
		local zIndex = 1 - 0.05*frame.ZIndex

		local tl = frame.AbsolutePosition
		local br = tl + frame.AbsoluteSize
		local tr = Vector2.new(br.X, tl.Y)
		local bl = Vector2.new(tl.X, br.Y)

		-- 🔥 FIX Rotation
		local rot = 0
		for _, v in ipairs(parents) do
			rot = rot + v.Rotation
		end

		if rot ~= 0 and rot % 180 ~= 0 then
			local mid = tl:Lerp(br, 0.5)
			local s = math.sin(math.rad(rot))
			local c = math.cos(math.rad(rot))

			local function rotate(p)
				return Vector2.new(
					c*(p.X - mid.X) - s*(p.Y - mid.Y),
					s*(p.X - mid.X) + c*(p.Y - mid.Y)
				) + mid
			end

			tl = rotate(tl)
			tr = rotate(tr)
			bl = rotate(bl)
			br = rotate(br)
		end

		-- 🔥 FIX parts กันหาย
		if #parts < 4 then
			for i = 1,4 do
				parts[i] = parts[i] or nil
			end
		end

		DrawQuad(
			camera:ScreenPointToRay(tl.X, tl.Y, zIndex).Origin,
			camera:ScreenPointToRay(tr.X, tr.Y, zIndex).Origin,
			camera:ScreenPointToRay(bl.X, bl.Y, zIndex).Origin,
			camera:ScreenPointToRay(br.X, br.Y, zIndex).Origin,
			parts
		)

		if first then
			for _,pt in pairs(parts) do
				if pt then
					pt.Parent = f
					pt.Transparency = 0.98
					pt.BrickColor = BrickColor.new("Institutional white")
				end
			end
		end
	end

	UpdateOrientation(true)

	RunService:BindToRenderStep(uid, 2000, function()
		if not frame or not frame.Parent then
			RunService:UnbindFromRenderStep(uid)
			for _,v in pairs(parts) do
				if v then v:Destroy() end
			end
			f:Destroy()
			DepthOfField:Destroy()
			return
		end

		UpdateOrientation()
	end)

	return {
		DepthOfField,
		frame
	}
end

return library
