local library = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService('RunService')
local camera = workspace.CurrentCamera

function library:BlurFrame(getFrame)
	local MTREL = "Glass"

	local root = Instance.new('Folder')
	root.Name = 'BlurSnox'
	root.Parent = camera

	local gToken = math.random(1,99999999)

	local DepthOfField = Instance.new('DepthOfFieldEffect')
	DepthOfField.Parent = game:GetService('Lighting')
	DepthOfField.FarIntensity = 0
	DepthOfField.FocusDistance = 51.6
	DepthOfField.InFocusRadius = 50
	DepthOfField.NearIntensity = 1
	DepthOfField.Name = "DPT_"..gToken

	local frame = Instance.new('Frame')
	frame.Parent = getFrame
	frame.Size = UDim2.new(0.95, 0, 0.95, 0)
	frame.Position = UDim2.new(0.5, 0, 0.5, 0)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundTransparency = 1

	local function GenUid()
		return "blur_"..tostring(math.random(1,9999999))
	end

	repeat RunService.RenderStepped:Wait() until camera

	-- ===== Draw System =====
	local function DrawTriangle(v1, v2, v3, p0, p1)
		local sz = 0.2

		local s1 = (v1 - v2).Magnitude
		local s2 = (v2 - v3).Magnitude
		local s3 = (v3 - v1).Magnitude
		local smax = math.max(s1, s2, s3)

		local A, B, C
		if s1 == smax then
			A,B,C = v1,v2,v3
		elseif s2 == smax then
			A,B,C = v2,v3,v1
		else
			A,B,C = v3,v1,v2
		end

		local para = ((B-A):Dot(C-A)) / (A-B).Magnitude
		local perp = math.sqrt((C-A).Magnitude^2 - para*para)
		local dif_para = (A-B).Magnitude - para

		local st = CFrame.new(B, A)
		local cf0 = st

		local Top_Look = (cf0 * CFrame.Angles(math.pi/2,0,0)).LookVector
		local Mid_Point = A + (CFrame.new(A, B).LookVector * para)
		local Needed_Look = CFrame.new(Mid_Point, C).LookVector

		local dot = math.clamp(Top_Look:Dot(Needed_Look), -1, 1)
		local ac = CFrame.Angles(0, 0, math.acos(dot))

		cf0 = cf0 * ac
		cf0 = cf0 * CFrame.new(0, perp/2, -(dif_para + para/2))

		local cf1 = st * ac * CFrame.Angles(0, math.pi, 0)
		cf1 = cf1 * CFrame.new(0, perp/2, dif_para/2)

		if not p0 then
			p0 = Instance.new("Part")
			p0.Anchored = true
			p0.CanCollide = false
			p0.CastShadow = false
			p0.Material = MTREL
			p0.Size = Vector3.new(sz,sz,sz)

			local mesh = Instance.new("SpecialMesh", p0)
			mesh.MeshType = Enum.MeshType.Wedge
			mesh.Name = "WedgeMesh"
		end

		p0.WedgeMesh.Scale = Vector3.new(0, perp/sz, para/sz)
		p0.CFrame = cf0

		if not p1 then
			p1 = p0:Clone()
		end

		p1.WedgeMesh.Scale = Vector3.new(0, perp/sz, dif_para/sz)
		p1.CFrame = cf1

		return p0, p1
	end

	local function DrawQuad(v1,v2,v3,v4,parts)
		parts[1], parts[2] = DrawTriangle(v1,v2,v3,parts[1],parts[2])
		parts[3], parts[4] = DrawTriangle(v3,v2,v4,parts[3],parts[4])
	end

	local parts = {}
	local uid = GenUid()

	local folder = Instance.new("Folder")
	folder.Parent = root

	local function RayPos(x,y)
		local ray = camera:ScreenPointToRay(x,y)
		return ray.Origin + ray.Direction * 10 -- 🔥 FIX สำคัญ
	end

	local function Update(first)
		local tl = frame.AbsolutePosition
		local br = tl + frame.AbsoluteSize
		local tr = Vector2.new(br.X, tl.Y)
		local bl = Vector2.new(tl.X, br.Y)

		DrawQuad(
			RayPos(tl.X, tl.Y),
			RayPos(tr.X, tr.Y),
			RayPos(bl.X, bl.Y),
			RayPos(br.X, br.Y),
			parts
		)

		if first then
			for _,v in pairs(parts) do
				v.Parent = folder
				v.Transparency = 0.98
				v.BrickColor = BrickColor.new("Institutional white")
			end
		end
	end

	Update(true)

	RunService:BindToRenderStep(uid, 2000, function()
		if not frame or not frame.Parent then
			RunService:UnbindFromRenderStep(uid)
			for _,v in pairs(parts) do if v then v:Destroy() end end
			folder:Destroy()
			DepthOfField:Destroy()
			return
		end

		Update()
	end)

	return {DepthOfField, frame}
end

return library
